{
  "name": "future-tech",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "watch": "concurrently \"npm run sass-watch\" \"npm run serve\"",
    "serve": "browser-sync start --server --files '**/*'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "sass-watch": "sass --watch .",
    "build:css": "sass --no-source-map --style=compressed assets/client/styles/main.scss assets/client/styles/main.css",
    "watch:css": "sass --watch --no-source-map --style=compressed assets/client/styles/main.scss assets/client/styles/main.css",
    "build": "npm run build:css && node scripts/build.mjs"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.0",
    "sass": "^1.80.6"
  }
}
